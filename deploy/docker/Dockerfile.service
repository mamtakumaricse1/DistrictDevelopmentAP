FROM node:20-alpine AS build
WORKDIR /app
ARG SERVICE
COPY package.json package-lock.json ./
COPY packages/common/package.json packages/common/package.json
COPY apps/gateway/package.json apps/gateway/package.json
COPY apps/identity/package.json apps/identity/package.json
COPY apps/organization/package.json apps/organization/package.json
COPY apps/works/package.json apps/works/package.json
COPY apps/governance/package.json apps/governance/package.json
COPY apps/notify/package.json apps/notify/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY packages/common packages/common
COPY apps/${SERVICE} apps/${SERVICE}
COPY scripts scripts
RUN npm run build -w @ddwmd/common
RUN if [ "$SERVICE" != "gateway" ]; then npm run prisma:generate -w @ddwmd/${SERVICE}; fi
RUN npm run build -w @ddwmd/${SERVICE}

FROM node:20-alpine AS runtime
WORKDIR /app
ARG SERVICE
ARG PORT=3000
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/common ./packages/common
COPY --from=build /app/apps/${SERVICE} ./apps/${SERVICE}
COPY deploy/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && mkdir -p /var/dashboard/storage
WORKDIR /app/apps/${SERVICE}
EXPOSE ${PORT}
ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "dist/main.js"]
