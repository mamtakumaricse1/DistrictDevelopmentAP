generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ORGANIZATION_DATABASE_URL")
}

enum AgencyType {
  IMPLEMENTING
  EXECUTING
  BOTH
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model District {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(32)
  name           String   @db.VarChar(200)
  stateCode      String   @map("state_code") @db.VarChar(16)
  stateName      String   @map("state_name") @db.VarChar(120)
  headquarters   String?  @db.VarChar(200)
  keycloakRealm  String?  @unique @map("keycloak_realm") @db.VarChar(64)
  keycloakIssuer String?  @unique @map("keycloak_issuer") @db.VarChar(300)
  timezone       String   @default("Asia/Kolkata") @db.VarChar(64)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdById    String?  @map("created_by_id") @db.Uuid
  updatedById    String?  @map("updated_by_id") @db.Uuid

  departments Department[]
  agencies    Agency[]
  settings    SystemSetting[]
  masterItems MasterDataItem[]

  @@map("districts")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  districtId  String   @map("district_id") @db.Uuid
  code        String   @db.VarChar(32)
  name        String   @db.VarChar(200)
  shortName   String?  @map("short_name") @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id") @db.Uuid
  updatedById String?  @map("updated_by_id") @db.Uuid

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)
  agencies Agency[]

  @@unique([districtId, code])
  @@index([districtId])
  @@map("departments")
}

model Agency {
  id           String     @id @default(uuid()) @db.Uuid
  districtId   String     @map("district_id") @db.Uuid
  departmentId String?    @map("department_id") @db.Uuid
  code         String     @db.VarChar(32)
  name         String     @db.VarChar(200)
  agencyType   AgencyType @map("agency_type")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdById  String?    @map("created_by_id") @db.Uuid
  updatedById  String?    @map("updated_by_id") @db.Uuid

  district   District    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([districtId, code])
  @@index([districtId])
  @@index([departmentId])
  @@map("agencies")
}

model MasterDataCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items MasterDataItem[]

  @@map("master_data_categories")
}

model MasterDataItem {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  districtId String?  @map("district_id") @db.Uuid
  code       String   @db.VarChar(64)
  name       String   @db.VarChar(200)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category MasterDataCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  district District?          @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([categoryId, districtId, code])
  @@index([categoryId, isActive])
  @@map("master_data_items")
}

model SystemSetting {
  id         String           @id @default(uuid()) @db.Uuid
  districtId String?          @map("district_id") @db.Uuid
  key        String           @db.VarChar(100)
  value      String           @db.Text
  valueType  SettingValueType @map("value_type")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([districtId, key])
  @@index([key])
  @@map("system_settings")
}
