{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@ddwmd/common$": "<rootDir>/../../packages/common/src"
  },
  "modulePathIgnorePatterns": ["<rootDir>/dist"],
  "transformIgnorePatterns": ["node_modules/(?!jose/)"]
}
