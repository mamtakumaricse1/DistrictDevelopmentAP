# Copy to .env at the repo root (and/or each service .env).
# NEVER commit real secrets.

# --- Application ---
NODE_ENV=development
APP_NAME=District Development Works Monitoring Dashboard
APP_PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Microservices ---
IDENTITY_URL=http://127.0.0.1:3001
ORGANIZATION_URL=http://127.0.0.1:3002
WORKS_URL=http://127.0.0.1:3003
GOVERNANCE_URL=http://127.0.0.1:3004
NOTIFY_URL=http://127.0.0.1:3005
IDENTITY_PORT=3001
ORGANIZATION_PORT=3002
WORKS_PORT=3003
GOVERNANCE_PORT=3004
NOTIFY_PORT=3005
GATEWAY_PORT=3000
INTERNAL_API_KEY=dev-internal-key
INTERNAL_HTTP_TIMEOUT_MS=3000
AUTH_CACHE_TTL_MS=15000
ISSUER_CACHE_TTL_MS=30000
CATALOG_CACHE_TTL_MS=30000
GATEWAY_PROXY_TIMEOUT_MS=120000
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=10
UPLOAD_MAX_BYTES=10485760

# --- PostgreSQL (one server, one database per service) ---
IDENTITY_DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/district_identity?schema=public
ORGANIZATION_DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/district_organization?schema=public
WORKS_DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/district_works?schema=public
GOVERNANCE_DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/district_governance?schema=public
NOTIFY_DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/district_notify?schema=public

# --- Document storage (Phase 5) ---
STORAGE_PROVIDER=local
STORAGE_ROOT=./storage
UPLOAD_MAX_BYTES=10485760

# --- Keycloak (one realm per district + system) ---
# KEYCLOAK_URL is the browser / JWT issuer base. Inside Docker, also set
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080 so APIs can fetch JWKS.
# Compose publishes Keycloak on 8180 (8080 is often taken by other stacks).
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_SYSTEM_REALM=system
KEYCLOAK_API_AUDIENCE=ddwmd-api
KEYCLOAK_WEB_CLIENT_ID=ddwmd-web

# --- Frontend (apps/web/.env) ---
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=District Development Works Monitoring Dashboard
VITE_KEYCLOAK_CLIENT_ID=ddwmd-web
