# =============================================================================
# District Works Dashboard — files that must not be pushed to GitHub
# Keep this file at the repository root only.
# =============================================================================

# --- Secrets and local environment (never commit real passwords or URLs) ---
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_rsa.pub
deploy/k8s/secret.yaml



# --- Dependencies (reinstall with npm install) ---
node_modules/

# --- Build output (recreate with npm run build / nest / vite) ---
dist/
build/
out/
*.tsbuildinfo

# --- Prisma generated clients (recreate with npm run prisma:generate) ---
**/src/generated/
**/generated/prisma/

# --- Uploaded project documents (disk storage, not Git) ---
/storage/
uploads/
tmp/
temp/

# --- Test / coverage / caches ---
coverage/
.nyc_output/
.cache/
.turbo/
**/.vite/
.eslintcache
*.lcov

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Database dumps and local backups ---
*.dump
*.backup
*.sql.gz
pgdata/

# --- Local reference documents (do not push to GitHub) ---
/library-packages-and-workflow.docx

# --- Editor and OS junk ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
